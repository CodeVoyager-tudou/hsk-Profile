# 环境变量模板（FE-08）
#
# 【用法】复制本文件为对应环境的文件后修改：
#     copy .env.example .env.development
#
# 【最重要的一条规则】
#     ⚠️ 绝不要把密钥（密码 / token / 私钥 / appSecret）写进 VITE_ 开头的变量。
#
#     原因：Vite 在打包时会把**所有** VITE_* 变量的值直接**内联进前端 JS 产物**。
#     也就是说，任何以 VITE_ 开头的值，最终都能被用户在浏览器里搜到 ——
#     它本质上就是公开信息，不是秘密。
#
#     需要密钥的功能（例如调用第三方支付），必须由**后端**持有密钥并代理调用，
#     前端只跟自己的后端通信。
#
#     本仓库的 scripts/check-env-secrets.mjs 会检查本规则，请勿绕过。
#
# 【这些文件会被提交吗】
#     .env / .env.development / .env.production / .env.staging / .env.test
#        -> 会被提交，用于各环境构建。**只能放非敏感配置**。
#     .env.local / .env.*.local
#        -> 已被 .gitignore 忽略，适合放个人本地覆盖项。

# ---- 页面标题（会显示在浏览器标签上）----
VITE_APP_TITLE = 慢性病健康商城

# ---- 环境标识 ----
# 取值：development / production / staging / test
VITE_APP_ENV = 'development'

# ---- 后端接口基础路径 ----
# 开发环境走 Vite 代理（见 vite.config.js 的 /dev-api 配置）
# 生产环境一般由 nginx 把 /prod-api 转发到网关 8080
VITE_APP_BASE_API = '/dev-api'

# ---- 支付倒计时展示窗口（分钟，默认 30）----
# 只影响收银台/订单列表的倒计时与"已超时"提示；真实关单由后端 RocketMQ 延迟消息决定
# （chronic.pay.timeout-delay-level=16 即 30 分钟，另有 2 分钟宽限 ≈ 32 分钟关单）。
# 演示时把它改成 1、同时把后端 PAY_TIMEOUT_DELAY_LEVEL 调小（如 2 + 3），
# 几十秒就能看到「待支付 → 已超时 → 自动关单」全过程。
# VITE_PAY_WINDOW_MINUTES = 30

# ---- 打包是否压缩（仅生产/预发布使用）----
# 支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# ---- 演示模式开关（安全相关，改动前请先读 utils/demoMode.js）----
# true ：后端连不上时自动降级为假数据/演示回答（**仅供本地演示与离线录屏**）
# false：后端连不上就如实报错（**生产必须为 false**）
#
# 为什么生产必须 false：
#   否则后端一故障，用户会看到"看起来正常"的假数据 ——
#   例如下单显示"下单成功（演示）"，但实际什么都没发生，用户还以为买到了。
VITE_ENABLE_DEMO = true
