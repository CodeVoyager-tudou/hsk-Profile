# =============================================
# 环境变量模板（复制成 .env.local 或写进部署机 systemd/docker 环境，切勿提交真实值）
# 四个服务的 application.yml 已不提供任何默认口令：缺失即启动失败（fail-fast），
# 生产 profile 下若仍是弱值，启动期自检会直接拒绝启动（见 SecurityHardeningValidator）。
# =============================================

# JWT 密钥（>=32 字节强随机值；gateway 与 user-service 必须一致）
JWT_SECRET=replace-with-strong-random

# 服务间内部令牌（points-service 与 shop-service 必须一致；支付回调也用它校验）
INTERNAL_TOKEN=replace-with-strong-random

# xxl-job 调度中心访问令牌（需与 admin 的 xxl.job.accessToken 一致）
XXL_JOB_ACCESS_TOKEN=replace-with-strong-random

# Python AI 服务的内部令牌（设置后 user-service 会带 X-Internal-Token 调用；留空=不校验）
AI_INTERNAL_TOKEN=

# 阿里云 OSS（图片上传：头像/药品图片；user-service 与 shop-service 使用）
# 从 OSS 控制台创建 AccessKey（建议 RAM 子账号，只授予该桶的读写权限）。
# 四项全部非空时 OSS Bean 才会装配；留空则图片接口报 503"对象存储未启用"，其余功能不受影响。
OSS_BUCKET=qk-parent-xcu
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 接口文档面板（knife4j，三个 Servlet 服务）；生产必须注入 false（启动自检会断言）
KNIFE4J_ENABLE=true

# MySQL（VM 内 Docker，默认端口 3307）
MYSQL_HOST=192.168.100.128
MYSQL_PORT=3307
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-strong-random

# Redis（令牌黑名单 / 优惠券分布式锁 / 登录失败计数）
REDIS_HOST=192.168.100.128
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-random

# 其它中间件地址（可选，默认见各服务 application.yml）
NACOS_ADDR=192.168.100.128:8848
NACOS_USERNAME=
NACOS_PASSWORD=
SENTINEL_DASHBOARD=192.168.100.128:8858
XXL_JOB_ADMIN=http://192.168.100.128:8082/xxl-job-admin
ROCKETMQ_NAMESRV=192.168.100.128:9876
AI_BASE_URL=http://localhost:9000

# 支付：本项目不接真实支付渠道，模拟渠道即最终形态（true=下单即确认；false=等模拟回调）
PAY_MOCK_AUTO_CONFIRM=true
